# Copy this file to ~/.config/agent-console/remote/remote.env and set mode 0600.
# Only the Supabase URL and publishable/anon key belong on the workstation.
# Never put a Supabase sb_secret/service_role key, VPS password, or SSH private
# key contents in this file.

AGENT_CONSOLE_REMOTE_ARMED=0
AGENT_CONSOLE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
AGENT_CONSOLE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
AGENT_CONSOLE_PUBLIC_BASE_URL=https://remote.example.com
AGENT_CONSOLE_GATEWAY_LOCAL_HOST=127.0.0.1
AGENT_CONSOLE_GATEWAY_LOCAL_PORT=43127
AGENT_CONSOLE_GATEWAY_VPS_PORT=43128

AGENT_CONSOLE_VPS_HOST=vps.example.com
AGENT_CONSOLE_VPS_USER=agent-console-tunnel
AGENT_CONSOLE_VPS_SSH_PORT=22
AGENT_CONSOLE_VPS_HOST_ED25519_SHA256=SHA256:REPLACE_WITH_VERIFIED_FINGERPRINT

AGENT_CONSOLE_SSH_KEY_PATH=/home/YOU/.config/agent-console/remote/ssh/id_ed25519
AGENT_CONSOLE_SSH_PUBLIC_KEY_PATH=/home/YOU/.config/agent-console/remote/ssh/id_ed25519.pub
AGENT_CONSOLE_SSH_KNOWN_HOSTS_PATH=/home/YOU/.config/agent-console/remote/ssh/known_hosts
AGENT_CONSOLE_VPS_PROXY=caddy
