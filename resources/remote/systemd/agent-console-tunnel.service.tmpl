[Unit]
Description=Agent Console autossh loopback reverse tunnel
After=network-online.target agent-console-gateway.service
Wants=network-online.target
Requires=agent-console-gateway.service
PartOf=agent-console-gateway.service
ConditionPathExists=@@REMOTE_ENV_FILE@@

[Service]
Type=simple
EnvironmentFile=-@@REMOTE_ENV_FILE@@
Environment=AUTOSSH_GATETIME=0
Environment=AUTOSSH_PORT=0
Environment=DISPLAY=
Environment=WAYLAND_DISPLAY=
ExecCondition=/usr/bin/test -x "@@REMOTE_LAUNCHER@@"
ExecCondition=/usr/bin/test -r "@@SSH_KEY_PATH@@"
ExecCondition=/usr/bin/test -r "@@SSH_PUBLIC_KEY_PATH@@"
ExecCondition=/usr/bin/test -r "@@KNOWN_HOSTS_PATH@@"
ExecStart="@@REMOTE_LAUNCHER@@" tunnel-run "--env-file=@@REMOTE_ENV_FILE@@"
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=tmpfs
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
BindReadOnlyPaths=@@REMOTE_ENV_FILE@@
BindReadOnlyPaths=@@SSH_KEY_PATH@@
BindReadOnlyPaths=@@SSH_PUBLIC_KEY_PATH@@
BindReadOnlyPaths=@@KNOWN_HOSTS_PATH@@
BindReadOnlyPaths=@@REMOTE_RUNTIME_PATH@@
@@APPLICATION_READ_ONLY_LINE@@

[Install]
WantedBy=default.target
