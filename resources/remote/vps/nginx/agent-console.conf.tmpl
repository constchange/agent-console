limit_req_zone $binary_remote_addr zone=agent_console_remote_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=agent_console_remote_events:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=agent_console_remote_connections:10m;

server {
    listen 80;
    listen [::]:80;
    server_name @@REMOTE_DOMAIN@@;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @@REMOTE_DOMAIN@@;

    ssl_certificate /etc/letsencrypt/live/@@REMOTE_DOMAIN@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@@REMOTE_DOMAIN@@/privkey.pem;
    client_max_body_size 256k;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location ~ ^/v1/events(?:/stream)?$ {
        limit_req zone=agent_console_remote_events burst=4 nodelay;
        limit_conn agent_console_remote_connections 3;
        proxy_pass http://127.0.0.1:@@VPS_GATEWAY_PORT@@;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 330s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /v1/ {
        limit_req zone=agent_console_remote_api burst=20 nodelay;
        limit_conn agent_console_remote_connections 10;
        proxy_pass http://127.0.0.1:@@VPS_GATEWAY_PORT@@;
        proxy_http_version 1.1;
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_read_timeout 65s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location = /healthz {
        limit_req zone=agent_console_remote_api burst=5 nodelay;
        limit_conn agent_console_remote_connections 3;
        proxy_pass http://127.0.0.1:@@VPS_GATEWAY_PORT@@;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        return 404;
    }
}
