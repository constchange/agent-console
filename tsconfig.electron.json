{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "electron"],
    "rootDir": ".",
    "outDir": "dist/electron",
    "sourceMap": true,
    "noEmit": false
  },
  "include": ["electron/**/*.ts", "core/**/*.ts", "gateway/**/*.ts", "shared/**/*.ts"]
}
